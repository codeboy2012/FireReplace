<UserControl x:Class="FireReplace.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FireReplace.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:WelcomeViewModel}"
             mc:Ignorable="d">

    <Border Style="{StaticResource CardStyle}"
            Padding="34"
            MaxWidth="660"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/icon.png"
                       Width="48" Height="48"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Welcome to FireReplace" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Fire TV customization made simple." Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,24,0,0"
                       Text="FireReplace changes settings and packages on your Fire TV using ADB. Every change is shown with its current and new value before it runs, and nothing happens until you approve it." />

            <Border Style="{StaticResource InsetStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="WHAT FIREREPLACE WILL NEVER DO" Style="{StaticResource SectionLabelStyle}" />
                    <ItemsControl ItemsSource="{Binding Guarantees}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="&#x2022;" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource SecondaryTextStyle}" MaxWidth="520" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="SAFETY CHECKLIST" Style="{StaticResource SectionLabelStyle}" Margin="0,22,0,0" />

            <CheckBox Margin="0,12,0,0" IsChecked="{Binding UnderstandsModification}"
                      Content="I understand FireReplace modifies my TV" />
            <CheckBox Margin="0,10,0,0" IsChecked="{Binding WillReviewChanges}"
                      Content="I will review changes before applying them" />
            <CheckBox Margin="0,10,0,0" IsChecked="{Binding UnderstandsProtection}"
                      Content="I understand FireReplace does not bypass protected Fire OS packages" />

            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                <Button Content="Continue"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="130"
                        IsDefault="True"
                        Command="{Binding ContinueCommand}" />
                <TextBlock Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           Text="Tick all three boxes to continue."
                           Visibility="{Binding CanContinue, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
