<UserControl x:Class="FireReplace.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FireReplace.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ConnectViewModel}"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <Grid Margin="40,36,40,36" MaxWidth="900" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Brand header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,28">
                <Image Source="pack://application:,,,/Assets/icon.png"
                       Width="56" Height="56"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" />
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="FireReplace" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Fire TV customization made simple."
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Connection card -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24">
                <StackPanel>
                    <TextBlock Text="ADB STATUS" Style="{StaticResource SectionLabelStyle}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse Width="10" Height="10"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding StatusHeadline}"
                                   Margin="10,0,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusDetail}"
                               Style="{StaticResource MonoTextStyle}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="20,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding StatusDetail, Converter={StaticResource EmptyStringToVisibility}}" />

                    <!-- Authorization help -->
                    <Border Style="{StaticResource InsetStyle}"
                            Margin="0,16,0,0"
                            BorderBrush="{DynamicResource WarningBrush}"
                            Visibility="{Binding ShowAuthorizationHelp, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Check your TV" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,6,0,0"
                                       Text="Your Fire TV may be asking whether to allow this computer to use ADB. Approve the prompt on the TV, then press Retry. FireReplace never bypasses this prompt." />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Retry" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RetryCommand}" />
                                <Button Content="Disconnect" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Command="{Binding DisconnectCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Causes -->
                    <ItemsControl ItemsSource="{Binding Causes}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="&#x2022;" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,8,0" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource SecondaryTextStyle}" MaxWidth="700" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,20" />

                    <TextBlock Text="FIRE TV IP ADDRESS" Style="{StaticResource SectionLabelStyle}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="IpBox"
                                 Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="45"
                                 AutomationProperties.Name="Fire TV IP address"
                                 FontFamily="{StaticResource MonoFont}" />

                        <Button Grid.Column="1"
                                Content="Connect"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="10,0,0,0"
                                MinWidth="110"
                                MinHeight="38"
                                IsDefault="True"
                                Command="{Binding ConnectCommand}" />
                    </Grid>

                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Margin="0,8,0,0"
                               Text="On the TV: Settings &#x203A; My Fire TV &#x203A; About &#x203A; Network shows the address. ADB debugging must be on under Developer options." />

                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Foreground="{DynamicResource DangerBrush}"
                               Margin="0,6,0,0"
                               Text="That does not look like an IPv4 or IPv6 address."
                               Visibility="{Binding IsIpValid, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Setup checklist -->
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="PLATFORM TOOLS" Style="{StaticResource SectionLabelStyle}" />
                            <Button Content="Re-scan"
                                    Style="{StaticResource LinkButtonStyle}"
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    Command="{Binding RefreshToolchainCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding PlatformToolsItems}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Glyph}"
                                                   Width="18"
                                                   FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSatisfied}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Label}" FontSize="12.5" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       FontSize="11"
                                                       FontFamily="{StaticResource MonoFont}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="APKS" Style="{StaticResource SectionLabelStyle}" />
                        <ItemsControl ItemsSource="{Binding ApkItems}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Glyph}"
                                                   Width="18"
                                                   FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSatisfied}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Label}" FontSize="12.5" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       FontSize="11"
                                                       FontFamily="{StaticResource MonoFont}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0"
                                   Text="FireReplace never downloads an APK. It only installs files you put in the apks folder yourself." />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
