<UserControl x:Class="FireReplace.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FireReplace.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DiagnosticsViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="FactTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource MonoTextStyle}"
                           FontSize="11.5" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,24,28,16">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Run checks" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RunChecksCommand}" />
                <Button Content="Reboot Fire TV" Style="{StaticResource SubtleButtonStyle}" Margin="8,0,0,0" Command="{Binding RebootCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="28,0,28,24">

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="THIS PC" Style="{StaticResource SectionLabelStyle}" />
                        <ItemsControl ItemsSource="{Binding Environment}" ItemTemplate="{StaticResource FactTemplate}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ADB" Style="{StaticResource SectionLabelStyle}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="adb version" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding AdbVersion}" Style="{StaticResource MonoTextStyle}" FontSize="11.5" TextWrapping="Wrap" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="adb devices" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            <Border Grid.Column="1" Style="{StaticResource InsetStyle}" Padding="10,8">
                                <TextBlock Text="{Binding DeviceListing}" Style="{StaticResource MonoTextStyle}" FontSize="11.5" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="FIRE TV" Style="{StaticResource SectionLabelStyle}" />
                        <ItemsControl ItemsSource="{Binding Device}" ItemTemplate="{StaticResource FactTemplate}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Backups -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Backups" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0" MaxWidth="700"
                                           Text="A backup records the device identity, the settings FireReplace manages and the enabled/disabled state of the packages in its catalog. It does not include apps, accounts or any private data. Restoring shows every difference before writing anything." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="Create backup" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateBackupCommand}" />
                                <Button Content="Open folder" Style="{StaticResource SubtleButtonStyle}" Margin="8,0,0,0" Command="{Binding OpenBackupFolderCommand}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Backups}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetStyle}" Margin="0,0,0,6" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayLabel}" FontSize="13" />
                                                <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,3,0,0">
                                                    <Run Text="{Binding SettingCount, Mode=OneWay}" />
                                                    <Run Text="settings ·" />
                                                    <Run Text="{Binding PackageCount, Mode=OneWay}" />
                                                    <Run Text="packages ·" />
                                                    <Run Text="{Binding Id, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Restore"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    FontSize="12" Padding="12,6"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"
                                   Text="No backups yet."
                                   Visibility="{Binding Backups.Count, Converter={StaticResource EmptyCountToVisibility}}" />
                    </StackPanel>
                </Border>

                <ProgressBar Style="{StaticResource ThinProgressStyle}"
                             Margin="0,12,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
