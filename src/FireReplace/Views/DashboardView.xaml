<UserControl x:Class="FireReplace.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FireReplace.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="28,24,28,16">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0">
                    <Run Text="read at" />
                    <Run Text="{Binding LastRefreshed, Mode=OneWay}" />
                </TextBlock>
                <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="28,0,28,24">

                <!-- Cards -->
                <UniformGrid Columns="3" Margin="0,0,-14,0">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,14,14">
                        <StackPanel>
                            <TextBlock Text="DEVICE" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="{Binding DeviceName}" Style="{StaticResource MetricValueStyle}" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding DeviceModel}" Style="{StaticResource MonoTextStyle}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding DeviceAndroid}" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding DeviceBuild}" Style="{StaticResource MutedTextStyle}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,14,14">
                        <StackPanel>
                            <TextBlock Text="CONNECTION" Style="{StaticResource SectionLabelStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{DynamicResource SuccessBrush}" />
                                <TextBlock Text="{Binding ConnectionState}" Style="{StaticResource MetricValueStyle}" Margin="9,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding ConnectionSerial}" Style="{StaticResource MonoTextStyle}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="Commands are sent over the network on TCP 5555." Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,14,14">
                        <StackPanel>
                            <TextBlock Text="LAUNCHER" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="{Binding LauncherState}" Style="{StaticResource MetricValueStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Home on Fire redirects the Home button; Projectivy draws the home screen." Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,14,14">
                        <StackPanel>
                            <TextBlock Text="PERFORMANCE" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="Animations" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding AnimationState}" Style="{StaticResource MetricValueStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,14,14">
                        <StackPanel>
                            <TextBlock Text="PRIVACY" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="Advertising tracking" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding PrivacyState}" Style="{StaticResource MetricValueStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,14,14">
                        <StackPanel>
                            <TextBlock Text="DEBLOAT" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="{Binding DebloatState}" Style="{StaticResource MetricValueStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Verified package list, disabled for user 0 only." Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Guided setup -->
                <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Recommended setup" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"
                                       Text="Runs the verified workflow in one pass: install both launcher apps, grant Home on Fire the permission it needs, add the Projectivy accessibility service without removing Home on Fire's, apply the animation and privacy settings, and disable the verified package list." />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"
                                       Text="Notification access and every experimental setting stay out of this. You will see the full list of changes before anything runs." />
                            <TextBlock Style="{StaticResource MutedTextStyle}"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Margin="0,8,0,0"
                                       Text="{Binding BackupHint}"
                                       Visibility="{Binding BackupHint, Converter={StaticResource EmptyStringToVisibility}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="Run recommended setup"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="190"
                                    Command="{Binding RecommendedSetupCommand}" />
                            <Button Content="Create backup first"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,8,0,0"
                                    MinWidth="190"
                                    Command="{Binding CreateBackupCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ProgressBar Style="{StaticResource ThinProgressStyle}"
                             Margin="0,12,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
