<UserControl x:Class="FireReplace.Views.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FireReplace.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:PreferencesViewModel}"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="28,0,28,24" MaxWidth="900" HorizontalAlignment="Left">

                <!-- General -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="GENERAL" Style="{StaticResource SectionLabelStyle}" />

                        <CheckBox Margin="0,14,0,0" IsChecked="{Binding AutoConnectOnStartup}"
                                  Content="Connect automatically at startup using the remembered address" />
                        <CheckBox Margin="0,10,0,0" IsChecked="{Binding RememberLastIp}"
                                  Content="Remember the last Fire TV IP address" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="28,4,0,0">
                            <Run Text="Stored:" />
                            <Run Text="{Binding LastIpAddress, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="28,4,0,0"
                                   Text="Only the address is stored. FireReplace never saves credentials, tokens or ADB keys." />

                        <TextBlock Text="THEME" Style="{StaticResource SectionLabelStyle}" Margin="0,18,0,0" />
                        <RadioButton Style="{StaticResource OptionRadioStyle}" GroupName="Theme" Margin="0,8,0,0"
                                     Content="Dark — the default" IsChecked="{Binding IsDarkTheme}" />
                        <RadioButton Style="{StaticResource OptionRadioStyle}" GroupName="Theme"
                                     Content="Midnight — deeper background, higher contrast" IsChecked="{Binding IsMidnightTheme}" />
                    </StackPanel>
                </Border>

                <!-- ADB -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ADB" Style="{StaticResource SectionLabelStyle}" />

                        <TextBlock Text="Platform Tools location" Style="{StaticResource SecondaryTextStyle}" Margin="0,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PlatformToolsDirectory}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     AutomationProperties.Name="Platform tools folder" />
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0" Command="{Binding BrowsePlatformToolsCommand}" />
                            <Button Grid.Column="2" Content="Use default" Style="{StaticResource SubtleButtonStyle}"
                                    Margin="6,0,0,0" Command="{Binding ClearPlatformToolsCommand}" />
                        </Grid>
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"
                                   Text="Leave this empty to use the platform-tools folder next to FireReplace.exe." />

                        <TextBlock Text="APK folder" Style="{StaticResource SecondaryTextStyle}" Margin="0,16,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ApkDirectory}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     AutomationProperties.Name="APK folder" />
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0" Command="{Binding BrowseApkFolderCommand}" />
                            <Button Grid.Column="2" Content="Use default" Style="{StaticResource SubtleButtonStyle}"
                                    Margin="6,0,0,0" Command="{Binding ClearApkFolderCommand}" />
                        </Grid>

                        <Border Style="{StaticResource InsetStyle}" Margin="0,14,0,0">
                            <TextBlock Text="{Binding ToolchainSummary}" Style="{StaticResource MonoTextStyle}"
                                       FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="ADB port" Style="{StaticResource MutedTextStyle}" />
                                <TextBox Text="{Binding AdbPort}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}"
                                         AutomationProperties.Name="ADB port" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Connection timeout (s)" Style="{StaticResource MutedTextStyle}" />
                                <TextBox Text="{Binding ConnectTimeoutSeconds}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}"
                                         AutomationProperties.Name="Connection timeout in seconds" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Command timeout (s)" Style="{StaticResource MutedTextStyle}" />
                                <TextBox Text="{Binding CommandTimeoutSeconds}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}"
                                         AutomationProperties.Name="Command timeout in seconds" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Safety -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SAFETY" Style="{StaticResource SectionLabelStyle}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Dry run" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                                           Text="Nothing is written to the Fire TV. FireReplace shows the exact commands it would run instead. Reading device state still works." />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding DryRun}"
                                          AutomationProperties.Name="Dry run" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,14" />

                        <CheckBox IsChecked="{Binding ConfirmDestructiveActions}"
                                  Content="Confirm every change before it runs" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="28,4,0,0"
                                   Text="With this off, single setting toggles apply immediately. Package changes, installs, reboots and experimental settings are always confirmed regardless." />

                        <CheckBox IsChecked="{Binding ConfirmAdvancedActions}" Margin="0,12,0,0"
                                  Content="Require confirmation for advanced and experimental actions" />
                        <CheckBox IsChecked="{Binding OfferBackupBeforeChanges}" Margin="0,12,0,0"
                                  Content="Offer to create a backup after connecting" />

                        <Border Style="{StaticResource InsetStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="What FireReplace will never do" Style="{StaticResource SectionLabelStyle}" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"
                                           Text="No root, no exploits, no bootloader unlocking, no firmware flashing, no factory reset, no bypassing Fire OS protected packages, and no free-form shell command box. These are not options that can be switched on." />
                            </StackPanel>
                        </Border>

                        <Button Content="Show the welcome checklist again"
                                Style="{StaticResource SubtleButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0"
                                Command="{Binding ShowFirstRunAgainCommand}" />
                    </StackPanel>
                </Border>

                <!-- Logs -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="LOGS" Style="{StaticResource SectionLabelStyle}" />

                        <StackPanel Margin="0,14,0,0" MaxWidth="260" HorizontalAlignment="Left">
                            <TextBlock Text="Maximum log entries kept in memory" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding MaxLogEntries}" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}"
                                     AutomationProperties.Name="Maximum log entries" />
                        </StackPanel>

                        <CheckBox IsChecked="{Binding SaveLogsAutomatically}" Margin="0,14,0,0"
                                  Content="Append log entries to a file as they happen" />
                        <TextBlock Text="{Binding AutoLogPath}" Style="{StaticResource MonoTextStyle}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="28,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="28,6,0,0"
                                   Text="Logs contain adb commands, package names and device properties. They never contain credentials or tokens. Exporting is always your choice." />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Open log folder" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenLogFolderCommand}" />
                            <Button Content="Open settings folder" Style="{StaticResource SubtleButtonStyle}" Margin="8,0,0,0" Command="{Binding OpenConfigFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
