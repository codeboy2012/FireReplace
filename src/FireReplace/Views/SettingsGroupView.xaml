<UserControl x:Class="FireReplace.Views.SettingsGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FireReplace.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SettingsGroupViewModel}"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,24,28,16">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Refresh"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="28,0,28,24">

                <!-- Page level warning, used by the Advanced page -->
                <Border Style="{StaticResource InsetStyle}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        Margin="0,0,0,18"
                        Visibility="{Binding Warning, Converter={StaticResource EmptyStringToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="ADVANCED / EXPERIMENTAL"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="{Binding Warning}" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{Binding Description}"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       Margin="0,6,0,0"
                                                       MaxWidth="640" />
                                        </StackPanel>
                                        <Border Style="{StaticResource PillStyle}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Two-option selector for the animation group -->
                                    <StackPanel Margin="0,16,0,0"
                                                Visibility="{Binding SupportsModeSelector, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="ANIMATION SPEED" Style="{StaticResource SectionLabelStyle}" />
                                        <RadioButton Style="{StaticResource OptionRadioStyle}"
                                                     GroupName="AnimationMode"
                                                     Content="Default — Fire OS animates every transition"
                                                     IsChecked="{Binding IsDefaultSelected, Mode=OneWay}"
                                                     Command="{Binding RevertCommand}"
                                                     Margin="0,8,0,0" />
                                        <RadioButton Style="{StaticResource OptionRadioStyle}"
                                                     GroupName="AnimationMode"
                                                     Content="Instant — all three animation scales set to 0"
                                                     IsChecked="{Binding IsFullyApplied, Mode=OneWay}"
                                                     Command="{Binding ApplyCommand}" />
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,4" />

                                    <!-- Individual settings -->
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource InsetStyle}" Margin="0,8,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                                                <Border Style="{StaticResource PillStyle}"
                                                                        Margin="8,0,0,0"
                                                                        BorderBrush="{DynamicResource WarningBrush}"
                                                                        Visibility="{Binding IsExperimental, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Text="EXPERIMENTAL" FontSize="9.5"
                                                                               Foreground="{DynamicResource WarningBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}"
                                                                       Style="{StaticResource MutedTextStyle}"
                                                                       Margin="0,4,0,0"
                                                                       MaxWidth="560" />
                                                            <TextBlock Style="{StaticResource MonoTextStyle}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,6,0,0">
                                                                <Run Text="{Binding QualifiedKey, Mode=OneWay}" />
                                                                <Run Text=" = " Foreground="{DynamicResource TextMutedBrush}" />
                                                                <Run Text="{Binding CurrentValue, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource PillStyle}"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding StateLabel}" FontSize="11" />
                                                        </Border>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Apply"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Padding="12,6"
                                                                    MinWidth="70"
                                                                    FontSize="12"
                                                                    Command="{Binding ApplyCommand}"
                                                                    Visibility="{Binding IsApplied, Converter={StaticResource InverseBoolToVisibility}}" />
                                                            <Button Content="Revert"
                                                                    Style="{StaticResource SubtleButtonStyle}"
                                                                    FontSize="12"
                                                                    Command="{Binding RevertCommand}"
                                                                    Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="Apply all"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding ApplyCommand}" />
                                        <Button Content="Revert all"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="8,0,0,0"
                                                Command="{Binding RevertCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource MutedTextStyle}"
                           Margin="2,4,0,0"
                           Text="FireReplace changes only the keys listed above. It cannot promise that Amazon stops collecting data: blocking network traffic needs router or DNS level controls." />

                <ProgressBar Style="{StaticResource ThinProgressStyle}"
                             Margin="0,12,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
