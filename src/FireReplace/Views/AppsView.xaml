<UserControl x:Class="FireReplace.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FireReplace.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AppsViewModel}"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,24,28,12">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Refresh"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <!-- APK installer -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="28,0,28,14">
            <StackPanel>
                <Grid>
                    <TextBlock Text="APK FILES IN THE LOCAL APKS FOLDER" Style="{StaticResource SectionLabelStyle}" />
                    <Button Content="Re-scan folder"
                            Style="{StaticResource LinkButtonStyle}"
                            HorizontalAlignment="Right"
                            FontSize="11"
                            Command="{Binding RescanApksCommand}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Apks}" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" Width="18" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Found}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource MonoTextStyle}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource PillStyle}" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding InstalledState}" FontSize="11" />
                                </Border>

                                <Button Grid.Column="3"
                                        Content="Install"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="12" Padding="12,6" MinWidth="72"
                                        Command="{Binding InstallCommand}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0"
                           Text="FireReplace installs only files that are already in this folder. It never downloads an APK and never installs one without showing you the file name first." />
            </StackPanel>
        </Border>

        <!-- Search + filters -->
        <Grid Grid.Row="2" Margin="28,0,28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{StaticResource SearchBoxStyle}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                     FontFamily="{StaticResource MonoFont}"
                     AutomationProperties.Name="Search package names"
                     MaxWidth="420"
                     HorizontalAlignment="Left" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource MutedTextStyle}" Margin="0,0,14,0" VerticalAlignment="Center" />
                <RadioButton Style="{StaticResource OptionRadioStyle}" GroupName="PackageFilter" Content="All" IsChecked="{Binding IsAllSelected}" Margin="0,0,12,0" />
                <RadioButton Style="{StaticResource OptionRadioStyle}" GroupName="PackageFilter" Content="Enabled" IsChecked="{Binding IsEnabledSelected}" Margin="0,0,12,0" />
                <RadioButton Style="{StaticResource OptionRadioStyle}" GroupName="PackageFilter" Content="Disabled" IsChecked="{Binding IsDisabledSelected}" Margin="0,0,12,0" />
                <RadioButton Style="{StaticResource OptionRadioStyle}" GroupName="PackageFilter" Content="Protected" IsChecked="{Binding IsProtectedSelected}" />
            </StackPanel>
        </Grid>

        <!-- Package list -->
        <ListBox Grid.Row="3"
                 Margin="28,0,24,20"
                 Style="{StaticResource PlainListBoxStyle}"
                 ItemContainerStyle="{StaticResource RowItemStyle}"
                 ItemsSource="{Binding Results}"
                 SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource InsetStyle}" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource MonoTextStyle}" FontSize="12.5" />
                                <TextBlock Text="{Binding Description}"
                                           Style="{StaticResource MutedTextStyle}"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           MaxWidth="560"
                                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource PillStyle}"
                                    Margin="0,0,8,0"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    Visibility="{Binding IsGuarded, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding GuardLabel}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource PillStyle}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource PackageStateBrush}}" />
                                    <TextBlock Text="{Binding StateLabel}" FontSize="11" Margin="7,0,0,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Disable"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="12" Padding="12,6" MinWidth="72"
                                        Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanDisable, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Enable"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        FontSize="12" Padding="12,6" MinWidth="72"
                                        Command="{Binding DataContext.EnableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanEnable, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
