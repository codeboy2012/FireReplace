<UserControl x:Class="FireReplace.Views.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FireReplace.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:LauncherViewModel}"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,24,28,16">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Refresh"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Margin="28,0,28,24">

                <!-- Apps -->
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitleStyle}" />
                                            <Border Style="{StaticResource PillStyle}" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding InstallState}" FontSize="11" />
                                            </Border>
                                            <Border Style="{StaticResource PillStyle}"
                                                    Margin="6,0,0,0"
                                                    BorderBrush="{DynamicResource SuccessBrush}"
                                                    Visibility="{Binding AccessibilityEnabled, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="ACCESSIBILITY ON" FontSize="10"
                                                           Foreground="{DynamicResource SuccessBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" MaxWidth="620" />

                                        <TextBlock Style="{StaticResource MonoTextStyle}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11"
                                                   Margin="0,8,0,0"
                                                   Text="{Binding PackageName}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="APK:" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding ApkState}" Style="{StaticResource MutedTextStyle}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                    Visibility="{Binding HasPermissions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Needs:" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding PermissionList}" Style="{StaticResource MutedTextStyle}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="Install / update"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                MinWidth="160"
                                                Command="{Binding InstallCommand}" />
                                        <Button Content="Grant permission"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                MinWidth="160"
                                                Margin="0,8,0,0"
                                                Command="{Binding GrantCommand}"
                                                Visibility="{Binding HasPermissions, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Accessibility -->
                <Border Style="{StaticResource CardStyle}" Margin="0,4,0,14">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Accessibility services" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0" MaxWidth="700"
                                           Text="Home on Fire uses an accessibility service to intercept the Home button, and Projectivy uses one for its own shortcuts. FireReplace reads the list first and only appends what is missing, so nothing already enabled is lost." />
                            </StackPanel>
                            <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding AccessibilityStatus}" FontSize="11" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource InsetStyle}">
                                <StackPanel>
                                    <TextBlock Text="CURRENT" Style="{StaticResource SectionLabelStyle}" />
                                    <ItemsControl ItemsSource="{Binding CurrentAccessibility}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="&#x2713;" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding}" Style="{StaticResource MonoTextStyle}" FontSize="11" TextWrapping="Wrap" MaxWidth="380" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource InsetStyle}">
                                <StackPanel>
                                    <TextBlock Text="PROPOSED" Style="{StaticResource SectionLabelStyle}" />
                                    <ItemsControl ItemsSource="{Binding ProposedAccessibility}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="&#x2713;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding}" Style="{StaticResource MonoTextStyle}" FontSize="11" TextWrapping="Wrap" MaxWidth="380" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Apply"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ApplyAccessibilityCommand}"
                                    IsEnabled="{Binding HasAccessibilityChanges}" />
                            <TextBlock Style="{StaticResource MutedTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Text="Nothing to add — both services are already enabled."
                                       Visibility="{Binding HasAccessibilityChanges, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notification access -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Notification access for Projectivy" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0" MaxWidth="700"
                                           Text="A notification listener can read the content of every notification the Fire TV shows, including notifications from other apps. Projectivy uses it to display them on its home screen. This is opt-in and is never part of the recommended setup." />
                                <TextBlock Style="{StaticResource MonoTextStyle}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,8,0,0"
                                           Text="{Binding NotificationComponent}" />
                            </StackPanel>
                            <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NotificationEnabled}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Margin="7,0,0,0" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                                                <Setter Property="Text" Value="Not enabled" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NotificationEnabled}" Value="True">
                                                        <Setter Property="Text" Value="Enabled" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Enable notification access"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding EnableNotificationsCommand}" />
                            <Button Content="Open the setting on the TV"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Margin="8,0,0,0"
                                    Command="{Binding OpenNotificationSettingsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ProgressBar Style="{StaticResource ThinProgressStyle}"
                             Margin="0,12,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
