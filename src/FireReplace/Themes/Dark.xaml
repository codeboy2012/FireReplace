<!--
    FireReplace dark palette.

    Warm fire accents are used sparingly: the accent colour marks the primary action, the connection
    indicator and the active navigation item. Everything else stays neutral so long package lists and
    log output remain comfortable to read.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Structure -->
    <Color x:Key="WindowBackgroundColor">#FF0E0F12</Color>
    <Color x:Key="SidebarBackgroundColor">#FF12141A</Color>
    <Color x:Key="SurfaceColor">#FF171A20</Color>
    <Color x:Key="SurfaceRaisedColor">#FF1E2229</Color>
    <Color x:Key="SurfaceHoverColor">#FF23272F</Color>
    <Color x:Key="BorderColor">#FF262B34</Color>
    <Color x:Key="BorderStrongColor">#FF343A45</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFE9ECF1</Color>
    <Color x:Key="TextSecondaryColor">#FF9AA2AE</Color>
    <Color x:Key="TextMutedColor">#FF6B7280</Color>
    <Color x:Key="TextOnAccentColor">#FF17100B</Color>

    <!-- Accent: fire -->
    <Color x:Key="AccentColor">#FFFF6B2C</Color>
    <Color x:Key="AccentHoverColor">#FFFF8148</Color>
    <Color x:Key="AccentPressedColor">#FFE85A1E</Color>
    <Color x:Key="AccentSoftColor">#332A1710</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#FF3FB950</Color>
    <Color x:Key="WarningColor">#FFD9A125</Color>
    <Color x:Key="DangerColor">#FFF0564B</Color>
    <Color x:Key="InfoColor">#FF5B9DD9</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <SolidColorBrush x:Key="OverlayBrush" Color="#CC05060A" />

</ResourceDictionary>
